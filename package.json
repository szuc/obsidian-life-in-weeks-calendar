{
	"name": "life-in-weeks-calendar",
	"version": "1.0.11",
	"description": "Displays your life in weeks with weekly notes integration.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "jest",
		"test:coverage": "jest --coverage"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"calendar"
	],
	"author": "Jeff Szuc",
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/moment": "^2.11.29",
		"@types/node": "^26.4.0",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jest": "^30.5.0",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"svelte-preprocess": "^6.0.5",
		"ts-jest": "^29.4.12",
		"tslib": "^2.8.1",
		"typescript": "6.0"
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"svelte": "^5.56.10",
		"svelte-eslint-parser": "^1.8.1"
	}
}
