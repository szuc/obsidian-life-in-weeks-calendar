{
	"name": "life-in-weeks-calendar",
	"version": "1.0.11",
	"description": "Displays your life in weeks with weekly notes integration.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "jest",
		"test:coverage": "jest --coverage"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"calendar"
	],
	"author": "Jeff Szuc",
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/eslintrc": "^3.3.5",
		"@types/jest": "^30.0.0",
		"@types/moment": "^2.11.29",
		"@types/node": "^24.13.1",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"builtin-modules": "^5.2.0",
		"esbuild": "^0.25.12",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.4",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^16.5.0",
		"jest": "^30.4.2",
		"obsidian": "^1.13.0",
		"prettier": "^3.8.4",
		"svelte-preprocess": "^6.0.5",
		"ts-jest": "^29.4.11",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@eslint/js": "^9.39.1",
		"date-fns": "^4.4.0",
		"svelte": "^5.56.3",
		"svelte-eslint-parser": "^1.8.0"
	}
}
